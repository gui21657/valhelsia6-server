# Copia este archivo a .env y edita los valores.
#   cp .env.example .env
# El archivo .env esta en .gitignore y nunca debe subirse al repositorio.

# --------------------------------------------------------------------------
# EULA
# --------------------------------------------------------------------------
# El servidor NO arranca hasta que pongas TRUE aqui.
# Al ponerlo en TRUE declaras que leiste y aceptas el EULA de Minecraft:
#   https://aka.ms/MinecraftEULA
# Nadie puede aceptarlo por ti. Dejalo en FALSE si no lo has leido.
EULA=FALSE

# --------------------------------------------------------------------------
# Version del modpack
# --------------------------------------------------------------------------
# Version verificada al escribir este repositorio: 6.2.3 (subida el 21/04/2025).
# Minecraft 1.20.1, Forge 1.20.1-47.4.0.
# Cliente y servidor deben usar EXACTAMENTE la misma version del pack.
VERSION_PACK=6.2.3

# --------------------------------------------------------------------------
# Memoria
# --------------------------------------------------------------------------
# Valhelsia 6 es pesado. Lee la tabla de RAM del README antes de bajar esto.
# RAM_MAXIMA nunca debe pasar de la mitad de la RAM fisica de la maquina.
RAM_INICIAL=4G
RAM_MAXIMA=8G

# --------------------------------------------------------------------------
# Red
# --------------------------------------------------------------------------
PUERTO=25565

# --------------------------------------------------------------------------
# Direccion publica sin abrir puertos (tunel de playit.gg)
# --------------------------------------------------------------------------
# Opcional. Sirve cuando el router no deja abrir el 25565, o cuando tu
# proveedor te tiene detras de CGNAT y la redireccion de puertos no funciona.
#
# Como se consigue la clave:
#   1. Crea una cuenta gratuita en https://playit.gg/
#   2. En su panel, anade un agente de tipo Docker. Te da una clave larga.
#   3. Pegala aqui abajo.
#   4. En el mismo panel crea un tunel "Minecraft Java" con:
#        Local Address = 172.28.0.10     (la IP fija del contenedor)
#        Local Port    = 25565
#   5. Arranca el tunel:  docker compose --profile tunel up -d
#   6. Mira la direccion que te asignaron:  ./direccion.sh
#
# Esto es una credencial. El .env esta en .gitignore: no la subas al repo.
PLAYIT_SECRET_KEY=

# --------------------------------------------------------------------------
# Ajustes de la partida
# --------------------------------------------------------------------------
DIFICULTAD=normal
MOTD=Servidor Valhelsia 6
MAX_JUGADORES=10
NOMBRE_MUNDO=world

# Distancias bajas ayudan mucho al rendimiento en un pack de este tamano.
DISTANCIA_VISION=8
DISTANCIA_SIMULACION=6

# true exige cuentas de Minecraft legitimas. Dejalo en true.
MODO_ONLINE=true

# Lista de operadores separados por coma. Ejemplo: OPERADORES=Jugador1,Jugador2
OPERADORES=

ZONA_HORARIA=America/Guatemala

# --------------------------------------------------------------------------
# CurseForge
# --------------------------------------------------------------------------
# Opcional. La imagen de Docker ya trae una clave para Java 17 y superiores,
# asi que normalmente puedes dejar esto vacio.
# Solo hace falta si la descarga falla por limite de uso, o si usas los
# scripts sin Docker con resolucion automatica de la ultima version.
# Se obtiene gratis en https://console.curseforge.com/
# NUNCA escribas la clave en docker-compose.yml ni la subas al repositorio.
CF_API_KEY=

# --------------------------------------------------------------------------
# Solo para los scripts sin Docker (iniciar.sh / iniciar.bat)
# --------------------------------------------------------------------------
# Carpeta donde se instalara el servidor.
DIR_SERVIDOR=servidor

# URL directa del server pack en la CDN oficial de CurseForge.
# Si cambias VERSION_PACK tienes que cambiar tambien esta URL: el id numerico
# del archivo no se puede deducir del numero de version.
# Como obtenerla: pagina del modpack en CurseForge, pestana Files, el archivo
# que dice SERVER, boton Download; el id del archivo aparece en la URL.
URL_SERVER_PACK=https://mediafilez.forgecdn.net/files/6448/193/Valhelsia-6-6.2.3-SERVER.zip

# Version de Forge incluida en ese server pack.
VERSION_FORGE=1.20.1-47.4.0

# Ruta al ejecutable de Java 17. Dejalo como "java" si ya esta en el PATH.
RUTA_JAVA=java
